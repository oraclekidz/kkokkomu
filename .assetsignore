# Cloudflare Workers serves this folder as-is (`npx wrangler deploy --assets=.`),
# so everything that is not part of the public site must be kept out of the asset tree.
# Same syntax as .gitignore.

.git/
.github/
data/
tools/
PROGRESS.md
# 특허 도면 출처 정리(제작 메모). 사이트에는 노출하지 않는다.
assets/patents/README.md
.assetsignore
.gitignore
__pycache__/
*.pyc
.DS_Store
